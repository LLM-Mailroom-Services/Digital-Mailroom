#!/usr/bin/env bash
# Keep the published Pages site in sync with main — no GitHub Actions.
#
# Fires on every `git push`: when refs/heads/main moves, it republishes
# gh-pages:/docs from the current working tree (scripts/publish_pages.sh).
#
# Failure policy (deliberately soft by default): a failed publish (e.g. a
# Langfuse hiccup) warns loudly but does NOT block the code push — re-run
# scripts/publish_pages.sh afterwards. Set MAILROOM_STRICT_SYNC=1 to make a
# failed republish abort the push instead.
#
# Enable once per clone (core.hooksPath is not cloned):
#   git config core.hooksPath hooks
set -uo pipefail

ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch-deletion pushes carry the zero sha; nothing to guard.
  [ "$local_sha" = "$ZERO" ] && continue

  # Secret guard: .env / key material must never be pushed to gh-pages
  # (public-serving branch). Applies to direct gh-pages pushes; the normal
  # publish path enforces the same rule in scripts/publish_pages.sh.
  if [ "$remote_ref" = "refs/heads/gh-pages" ]; then
    if git cat-file -e "$local_sha:.env" 2>/dev/null; then
      echo "[pages-sync] ABORT: pushing gh-pages with a committed .env (secret leak)" >&2
      echo "[pages-sync] remove it from the tree first: git rm --cached .env && git commit" >&2
      exit 1
    fi
    if git ls-tree -r --name-only "$local_sha" | grep -qE '(^|/)\.env$'; then
      echo "[pages-sync] ABORT: gh-pages push contains .env-like file(s)" >&2
      exit 1
    fi
  fi

  # Only react to updates of main.
  [ "$remote_ref" = "refs/heads/main" ] || continue

  echo "[pages-sync] main is moving to ${local_sha:0:7} — republishing site..."
  if scripts/publish_pages.sh --source "${MAILROOM_PUBLISH_SOURCE:-langfuse}"; then
    echo "[pages-sync] site republished in sync with main"
  else
    echo "" >&2
    echo "[pages-sync] WARNING: site republish FAILED — gh-pages is stale vs ${local_sha:0:7}" >&2
    echo "[pages-sync] fix the source, then run: scripts/publish_pages.sh" >&2
    echo "[pages-sync] (push proceeded; set MAILROOM_STRICT_SYNC=1 to block pushes on failure)" >&2
    [ "${MAILROOM_STRICT_SYNC:-0}" = "1" ] && exit 1
  fi
done

exit 0
